# Mobile apps (Expo). Only public values belong here — they are compiled into
# the app. No service keys, push credentials or signing keys.
APP_ENV=development            # development | staging | production
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Self-hosted pdf.js viewer on the admin website (used by Android)
EXPO_PUBLIC_PDF_VIEWER_URL=https://admin.example.com/pdf-viewer/index.html
EAS_PROJECT_ID=<expo-project-id>

# Required for staging/production builds — from the owner's VERIFIED store accounts:
IOS_BUNDLE_ID=
ANDROID_PACKAGE=
