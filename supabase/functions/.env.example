# Edge function secrets: set with `supabase secrets set --env-file ...`
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically.
PUSH_DISPATCH_SECRET=<random string, 32+ chars; same value stored in Vault for pg_cron>
# Optional: only if "enhanced push security" is enabled in the Expo dashboard
EXPO_ACCESS_TOKEN=
